# Falsify hosted Python runtime (container-internal HTTP API) - systemd unit.
# Installed by cloud/runtime/install-venv.sh to /etc/systemd/system/falsify-runtime.service.
# Secrets live only in /etc/falsify/runtime.env (mode 0600, outside the repository).
[Unit]
Description=Falsify hosted AI runtime (internal HTTP API)
After=network-online.target local-fs.target
Wants=network-online.target
# A missing or invalid configuration makes the runtime exit 2; stop instead of restart-looping.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=falsify-runtime
Group=falsify-runtime
WorkingDirectory=/opt/falsify/app/local

# Defaults first; the environment file may override bind/port. It must exist: no "-" prefix,
# so the unit fails closed when the file is missing. It is parsed by systemd as root.
Environment=PYTHONPATH=/opt/falsify
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=HOSTED_AI_BIND=127.0.0.1
Environment=HOSTED_AI_PORT=8787
EnvironmentFile=/etc/falsify/runtime.env

# Authoritative for this deployment: an environment-file value cannot redirect durable state.
Environment=HOSTED_AI_STATE_DIR=/var/lib/falsify
Environment=TMPDIR=/var/lib/falsify/tmp

ExecStart=/opt/falsify/venv/bin/python -m hosted_runtime
Restart=on-failure
RestartSec=2
TimeoutStopSec=30

# Hardening. MemoryDenyWriteExecute and SystemCallFilter are deliberately NOT enabled: mini-racer's
# V8 and the spawned native PDF workers need writable+executable mappings and scheduler/rseq syscalls.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/falsify
StateDirectory=falsify
StateDirectoryMode=0700
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
