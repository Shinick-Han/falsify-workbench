{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "falsify-cloud-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  // Password hashing uses the native node:crypto scrypt.
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "96aee9d5fb56f2efc3d90e147a67f558",
  "workers_dev": true,
  "preview_urls": false,
  "limits": { "cpu_ms": 1000 },
  "d1_databases": [{ "binding": "DB", "database_name": "falsify-harness-records", "database_id": "1dc5ab19-6f6d-43e0-a30a-e104ab337371", "migrations_dir": "migrations" }],
  "vars": {
    // Exact origins only; local test origins belong in .dev.vars or test bindings, never here.
    "ALLOWED_ORIGINS": "https://shinick-han.github.io,http://127.0.0.1:7816,http://localhost:7816",
    // Fixed Falsify site and space. Client secret, session key, and the full callback URL stay secrets.
    // Shipped default is Confluence-only. Legacy suites must set CONFLUENCE_ONLY to false explicitly.
    "REMOTE_PROVIDER": "confluence",
    "CONFLUENCE_SITE_URL": "https://falsify.atlassian.net",
    "CONFLUENCE_SPACE_KEY": "Falsify",
    "CONFLUENCE_SPACE_ID": "65737",
    // Operator-supplied archive parent in space 65737. Created under workspace page 66042.
    "CONFLUENCE_PARENT_PAGE_ID": "8355842",
    "ATLASSIAN_CLIENT_ID": "LQL1zmOGHXyk8V4ShnSdPJCc5MzJWYDN",
    "CONFLUENCE_ONLY": "true",
    // Hosted execution uses the operator runtime and password sessions; Confluence archives remain
    // separate. HOSTED_AI_SERVICE_TOKEN is a Wrangler secret, never a checked-in var.
    "AI_HOSTING_ENABLED": "true",
    "AI_RUNTIME_URL": "https://falsify-runtime.shinick.dev/production",
    "AI_MAX_UPLOAD_BYTES": "33554432",
    "AI_MAX_PROMPT_CHARS": "32000",
    "AI_MAX_CALLS_PER_JOB": "24",
    "AI_DEFAULT_CALLS": "12",
    "AI_UPLOADS_PER_OWNER_HOUR": "60",
    "AI_JOBS_PER_OWNER_HOUR": "20",
    "AI_ACTIVE_JOBS_PER_OWNER": "3",
    // Owner-paid policy. The token budget gates NEW model-call jobs on usage recorded from terminal
    // snapshots in the current window; 0 disables it. It is a policy limit, not an exact provider
    // balance, and apply-only edit jobs (no model calls) are never blocked by it.
    "AI_OWNER_TOKEN_BUDGET": "0",
    "AI_TOKEN_WINDOW_SECONDS": "86400",
    // Main Pages app is open: guests need no login and no access key. Caps bound the operator cost;
    // AI_OPEN_ACCESS=false is the kill switch. Claude and OpenAI ids match the runtime HOSTED_AI_MODELS.
    "AI_OPEN_ACCESS": "true",
    "AI_PAPER_TOOLS_ENABLED": "true",
    "AI_MODELS": "claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5,gpt-6.2-astra,gpt-5.5,gpt-5.4-mini",
    "AI_GUEST_SESSION_SECONDS": "21600",
    "AI_GUESTS_PER_IP_HOUR": "20",
    "AI_GUESTS_PER_HOUR": "300",
    "AI_GUEST_UPLOADS_PER_OWNER_HOUR": "10",
    "AI_GUEST_UPLOADS_PER_HOUR": "120",
    "AI_GUEST_MAX_UPLOAD_BYTES": "20971520",
    "AI_GUEST_JOBS_PER_OWNER_HOUR": "6",
    "AI_GUEST_ACTIVE_JOBS_PER_OWNER": "1",
    "AI_GUEST_MAX_CALLS_PER_JOB": "8",
    "AI_GUEST_JOBS_PER_HOUR": "40",
    "AI_GUEST_TOKEN_BUDGET": "3000000"
  },
  // Platform invocation logs are off (they carry client request metadata); the Worker emits one
  // structured line per request with route template, method, status and duration only.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "staging": {
      "name": "falsify-cloud-api-staging",
      "vars": {
        "ALLOWED_ORIGINS": "https://shinick-han.github.io,http://127.0.0.1:7849,http://localhost:7849",
        "REMOTE_PROVIDER": "confluence",
        "CONFLUENCE_SITE_URL": "https://falsify.atlassian.net",
        "CONFLUENCE_SPACE_KEY": "Falsify",
        "CONFLUENCE_SPACE_ID": "65737",
        "CONFLUENCE_PARENT_PAGE_ID": "8355842",
        "ATLASSIAN_CLIENT_ID": "LQL1zmOGHXyk8V4ShnSdPJCc5MzJWYDN",
        "CONFLUENCE_ONLY": "true",
        "AI_HOSTING_ENABLED": "true",
        "AI_RUNTIME_URL": "https://falsify-runtime.shinick.dev/staging",
        "AI_MAX_UPLOAD_BYTES": "33554432",
        "AI_MAX_PROMPT_CHARS": "32000",
        "AI_MAX_CALLS_PER_JOB": "24",
        "AI_DEFAULT_CALLS": "12",
        "AI_UPLOADS_PER_OWNER_HOUR": "60",
        "AI_JOBS_PER_OWNER_HOUR": "20",
        "AI_ACTIVE_JOBS_PER_OWNER": "3",
        "AI_OWNER_TOKEN_BUDGET": "0",
        "AI_TOKEN_WINDOW_SECONDS": "86400"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "falsify-harness-records-staging", "database_id": "43f6eef6-84a4-4039-9cd5-4e3520cea4e6", "migrations_dir": "migrations" }]
    },
    "event": {
      // Open-access booth page (event.html). Guests only; shares the production runtime.
      // HOSTED_AI_SERVICE_TOKEN and AI_OPEN_ACCESS_KEY are Wrangler secrets, never vars.
      // A 16 MiB PDF plus its digest needs more CPU than the production 1000 ms cap.
      "name": "falsify-cloud-api-event",
      "limits": { "cpu_ms": 5000 },
      "vars": {
        "ALLOWED_ORIGINS": "https://shinick-han.github.io",
        "REMOTE_PROVIDER": "confluence",
        "CONFLUENCE_SITE_URL": "https://falsify.atlassian.net",
        "CONFLUENCE_SPACE_KEY": "Falsify",
        "CONFLUENCE_SPACE_ID": "65737",
        "CONFLUENCE_PARENT_PAGE_ID": "8355842",
        "ATLASSIAN_CLIENT_ID": "LQL1zmOGHXyk8V4ShnSdPJCc5MzJWYDN",
        "CONFLUENCE_ONLY": "true",
        "AI_HOSTING_ENABLED": "true",
        "AI_OPEN_ACCESS": "true",
        // Booth edits body text in the browser. Off so a phone does not post each PDF to /v1/ai/paper. The operator may set this back to true.
        "AI_PAPER_TOOLS_ENABLED": "false",
        // Claude and OpenAI ids; the runtime HOSTED_AI_MODELS must list the same set.
        "AI_MODELS": "claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5,gpt-6.2-astra,gpt-5.5,gpt-5.4-mini",
        "AI_RUNTIME_URL": "https://falsify-runtime.shinick.dev/production",
        "AI_MAX_UPLOAD_BYTES": "33554432",
        "AI_MAX_PROMPT_CHARS": "32000",
        "AI_MAX_CALLS_PER_JOB": "24",
        "AI_DEFAULT_CALLS": "12",
        "AI_UPLOADS_PER_OWNER_HOUR": "60",
        "AI_JOBS_PER_OWNER_HOUR": "20",
        "AI_ACTIVE_JOBS_PER_OWNER": "3",
        "AI_OWNER_TOKEN_BUDGET": "0",
        "AI_TOKEN_WINDOW_SECONDS": "86400",
        "AI_GUEST_SESSION_SECONDS": "21600",
        "AI_GUESTS_PER_IP_HOUR": "600",
        "AI_GUESTS_PER_HOUR": "800",
        "AI_GUEST_UPLOADS_PER_OWNER_HOUR": "10",
        "AI_GUEST_UPLOADS_PER_HOUR": "400",
        "AI_GUEST_MAX_UPLOAD_BYTES": "20971520",
        "AI_GUEST_JOBS_PER_OWNER_HOUR": "20",
        "AI_GUEST_ACTIVE_JOBS_PER_OWNER": "1",
        "AI_GUEST_MAX_CALLS_PER_JOB": "8",
        "AI_GUEST_JOBS_PER_HOUR": "40",
        "AI_GUEST_APPLY_JOBS_PER_HOUR": "600",
        "AI_GUEST_BLUE": "false",
        "AI_GUEST_MODEL_JOBS": "false",
        // Sum of recorded guest usage per AI_TOKEN_WINDOW_SECONDS; sized well under the operator balance.
        "AI_GUEST_TOKEN_BUDGET": "4000000",
        // Booth submissions for the event page. BOOTH_OPERATOR_TOKEN stays a Wrangler secret.
        "BOOTH_ENABLED": "true",
        "BOOTH_CONSENT_VERSION": "2026-11-22.v3",
        "BOOTH_SUBMISSIONS_PER_IP_HOUR": "400",
        // Visitors poll the claim route for the live result from behind one venue NAT.
        "BOOTH_CLAIMS_PER_IP_HOUR": "8000",
        "BOOTH_CLAIMS_PER_HOUR": "15000",
        "BOOTH_OPERATOR_ACTIVE_JOBS": "2",
        "BOOTH_MAX_PDF_BYTES": "16777216",
        "BOOTH_STORED_PDF_BYTES": "3221225472",
        "AI_MODEL_JOBS_OPERATOR_ONLY": "true",
        "PAPER_SEARCH_ENABLED": "true",
        "PAPER_SEARCH_PER_IP_HOUR": "2000",
        "PAPER_PDF_PER_IP_HOUR": "600",
        // Agent recipe drafts (POST /v1/booth/recipes). No auth, CORS "*"; the human submits on EVENT_PAGE_URL.
        "BOOTH_RECIPES_PER_IP_HOUR": "120",
        "BOOTH_RECIPES_PER_HOUR": "5000",
        // GET /v1/booth/recipes/:code per IP (IPv6 per /64) per hour, so codes cannot be enumerated cheaply.
        "BOOTH_RECIPE_READS_PER_IP_HOUR": "600",
        "EVENT_PAGE_URL": "https://shinick-han.github.io/falsify-workbench/event.html"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "falsify-harness-records-event", "database_id": "939f0444-c8d6-4d3f-b9ca-e1def3bdfc4f", "migrations_dir": "migrations" }]
    }
  }
}

